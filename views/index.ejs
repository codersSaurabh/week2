<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Task Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h2>My Tasks</h2>
      <a href="/api/auth/logout" class="btn-logout">Logout</a>
    </div>

    <div class="task-input-group">
      <input type="text" id="taskTitle" placeholder="What needs to be done?" />
      <button onclick="addTask()" class="btn">Add Task</button>
    </div>

    <ul id="taskList" class="task-list"></ul>
  </div>

  <script>
    async function fetchTasks() {
      const res = await fetch('/api/tasks');
      if (res.status === 401) return window.location.href = '/login';
      const tasks = await res.json();
      const list = document.getElementById('taskList');
      list.innerHTML = '';
      if (tasks.length === 0) {
        list.innerHTML = '<p style="text-align: center; color: var(--text-muted); font-size: 14px;">No tasks yet. Add one above!</p>';
        return;
      }
      tasks.forEach(task => {
        list.innerHTML += `
          <li class="task-item ${task.completed ? 'completed' : ''}">
            <span>${task.title}</span>
            <div class="task-actions">
              <button class="btn-sm btn-complete" onclick="toggleTask('${task._id}', ${!task.completed})">
                ${task.completed ? 'Undo' : 'Done'}
              </button>
              <button class="btn-sm btn-delete" onclick="deleteTask('${task._id}')">Delete</button>
            </div>
          </li>
        `;
      });
    }

    async function addTask() {
      const input = document.getElementById('taskTitle');
      const title = input.value.trim();
      if (!title) return;
      await fetch('/api/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title })
      });
      input.value = '';
      fetchTasks();
    }

    async function toggleTask(id, completed) {
      await fetch('/api/tasks/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ completed })
      });
      fetchTasks();
    }

    async function deleteTask(id) {
      await fetch('/api/tasks/' + id, { method: 'DELETE' });
      fetchTasks();
    }

    fetchTasks();
  </script>
</body>
</html>